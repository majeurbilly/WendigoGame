DATABASE_URL=postgres://wendigo:wendigo@db:5432/wendigogame?sslmode=disable
REDIS_URL=redis://redis:6379
# Émetteur public attendu dans le claim iss du JWT (navigateur → souvent localhost).
OIDC_EXPECTED_ISSUER=http://localhost:9000/application/o/wendigo/
# Base URL pour résoudre le JWKS depuis le conteneur backend (réseau Docker → authentik-server).
OIDC_ISSUER_URL=http://localhost:9000/application/o/wendigo
# JWKS explicite (prioritaire). En Docker, surcharger avec http://authentik-server:9000/.../jwks/
AUTHENTIK_JWKS_URL=http://localhost:9000/application/o/wendigo/jwks/
# Diagnostic JWT (Ticket 7.2) : mettre à 1 pour désactiver exp/nbf côté golang-jwt (aud n’est pas exigé sans WithAudience).
# WENDIGO_JWT_SKIP_REGISTERED_CLAIM_VALIDATION=1
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
