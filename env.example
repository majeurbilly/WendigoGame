# 🐺 Wendigo Game - Variables d'Environnement
# Copiez ce fichier vers .env et modifiez les valeurs selon votre configuration

# =============================================================================
# CONFIGURATION BACKEND
# =============================================================================

# Base de données
DATABASE_URL=sqlite:///./wendigo_game.db
# Pour PostgreSQL: postgresql://user:password@localhost/wendigo_game

# Sécurité
SECRET_KEY=wendigo-game-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configuration de l'API
API_V1_STR=/api/v1
PROJECT_NAME=Wendigo Game
VERSION=1.0.0
DESCRIPTION=Jeu de Loup-Garou Hybride avec 29 rôles uniques

# CORS (Cross-Origin Resource Sharing)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Configuration du jeu
MIN_PLAYERS=8
MAX_PLAYERS=29
DAY_PHASE_DURATION=600
NIGHT_PHASE_DURATION=300
EVENING_PHASE_DURATION=180

# WebSocket
WEBSOCKET_PING_INTERVAL=20
WEBSOCKET_PING_TIMEOUT=20

# Debug et logging
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# CONFIGURATION FRONTEND
# =============================================================================

# URLs de l'API
REACT_APP_API_URL=http://localhost:8000/api/v1
REACT_APP_WS_URL=ws://localhost:8000/api/v1/ws

# Configuration de développement
REACT_APP_DEBUG=true
CHOKIDAR_USEPOLLING=true

# =============================================================================
# CONFIGURATION DOCKER
# =============================================================================

# Base de données PostgreSQL
POSTGRES_DB=wendigo_game
POSTGRES_USER=wendigo
POSTGRES_PASSWORD=wendigo123

# Redis (optionnel)
REDIS_URL=redis://localhost:6379

# =============================================================================
# CONFIGURATION PRODUCTION
# =============================================================================

# Pour la production, changez ces valeurs :
# DATABASE_URL=postgresql://prod_user:prod_password@prod_host/wendigo_game
# SECRET_KEY=your-super-secure-production-secret-key
# DEBUG=false
# BACKEND_CORS_ORIGINS=["https://yourdomain.com"]
# REACT_APP_API_URL=https://api.yourdomain.com/api/v1
# REACT_APP_WS_URL=wss://api.yourdomain.com/api/v1/ws
