@startuml WendigoGame_Complete
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classFontName Arial
skinparam packageStyle rectangle
skinparam linetype ortho

title 🏗️ Diagramme de Classe UML Complet - Wendigo Game

' ===== PACKAGES =====
package "🏠 Entités de Base" {
    class User {
        +id: UUID
        +username: String
        +email: String
        +password_hash: String
        +created_at: DateTime
        +last_login: DateTime
        +is_active: Boolean
        --
        +authenticate(password: String): Boolean
        +update_last_login(): void
    }

    class Player {
        +id: UUID
        +user_id: UUID
        +game_id: UUID
        +role_id: UUID
        +is_alive: Boolean
        +is_ready: Boolean
        +chair_position: Integer
        +has_selected_chair: Boolean
        +can_vote: Boolean
        +can_act: Boolean
        --
        +join_game(game: Game): void
        +leave_game(): void
        +select_chair(position: Integer): void
        +die(): void
        +revive(): void
    }

    class Game {
        +id: UUID
        +name: String
        +status: GameStatus
        +current_phase: Phase
        +phase_start_time: DateTime
        +phase_duration: Integer
        +min_players: Integer
        +max_players: Integer
        +current_player_count: Integer
        +winner_team: Team
        +created_at: DateTime
        +started_at: DateTime
        +ended_at: DateTime
        --
        +start_game(): void
        +end_game(): void
        +next_phase(): void
        +add_player(player: Player): void
        +remove_player(player: Player): void
    }

    class Role {
        +id: UUID
        +name: String
        +description: String
        +team: Team
        +phase_action: Phase
        +power_usage: PowerUsage
        +is_unique: Boolean
        +can_transform_team: Boolean
        +has_position_based_power: Boolean
        +has_communication_power: Boolean
        --
        +execute_power(target: UUID, context: Map): Boolean
        +can_use_power(): Boolean
        +get_power_description(): String
    }

    class Team {
        +id: UUID
        +name: String
        +description: String
        +win_condition: String
        +color: String
        +is_evil: Boolean
        --
        +check_win_condition(): Boolean
        +get_team_members(game: Game): List<Player>
    }
}

package "🎮 Système de Jeu" {
    class Phase {
        +id: UUID
        +name: String
        +description: String
        +duration: Integer
        +order: Integer
        +allows_actions: Boolean
        +allows_voting: Boolean
        +allows_chat: Boolean
        +next_phase: Phase
        +previous_phase: Phase
        --
        +start_phase(): void
        +end_phase(): void
        +get_remaining_time(): Integer
    }

    abstract class GameAction {
        +id: UUID
        +game_id: UUID
        +player_id: UUID
        +action_type: ActionType
        +target_id: UUID
        +phase: Phase
        +timestamp: DateTime
        +success: Boolean
        +result_message: String
        --
        +execute(): Boolean
        +validate(): Boolean
        +get_priority(): Integer
    }

    class Vote {
        +id: UUID
        +game_id: UUID
        +voter_id: UUID
        +target_id: UUID
        +vote_type: VoteType
        +phase: Phase
        +timestamp: DateTime
        +is_valid: Boolean
        --
        +cast_vote(): void
        +cancel_vote(): void
        +validate_vote(): Boolean
    }

    class ChatMessage {
        +id: UUID
        +game_id: UUID
        +sender_id: UUID
        +content: String
        +message_type: MessageType
        +recipient_id: UUID
        +timestamp: DateTime
        +is_anonymous: Boolean
        --
        +send_message(): void
        +delete_message(): void
        +get_recipients(): List<UUID>
    }
}

package "⚡ Système de Rôles et Pouvoirs" {
    class Power {
        +id: UUID
        +role_id: UUID
        +name: String
        +description: String
        +power_type: PowerType
        +target_type: TargetType
        +usage_limit: Integer
        +current_usage: Integer
        +phase_activation: Phase
        +priority: Integer
        --
        +execute(target: UUID, context: Map): Boolean
        +can_use(): Boolean
        +reset_usage(): void
    }

    class PowerEffect {
        +id: UUID
        +power_id: UUID
        +target_id: UUID
        +effect_type: EffectType
        +duration: Integer
        +strength: Integer
        +is_active: Boolean
        +applied_at: DateTime
        +expires_at: DateTime
        --
        +apply_effect(): void
        +remove_effect(): void
        +is_expired(): Boolean
    }

    class RoleTransformation {
        +id: UUID
        +player_id: UUID
        +old_role_id: UUID
        +new_role_id: UUID
        +transformation_type: TransformationType
        +triggered_by: UUID
        +timestamp: DateTime
        +is_permanent: Boolean
        --
        +execute_transformation(): void
        +revert_transformation(): void
    }
}

package "🪑 Système de Position et Chaises" {
    class Chair {
        +id: UUID
        +game_id: UUID
        +position: Integer
        +is_occupied: Boolean
        +occupied_by: UUID
        +is_selectable: Boolean
        +selection_start_time: DateTime
        +selection_end_time: DateTime
        --
        +occupy(player: Player): void
        +vacate(): void
        +make_selectable(): void
        +make_unselectable(): void
        +get_neighbors(): List<Chair>
    }

    class PositionManager {
        +game_id: UUID
        +chairs: List<Chair>
        +player_positions: Map<UUID, Integer>
        --
        +calculate_neighbors(player: Player): List<Player>
        +get_left_neighbor(player: Player): Player
        +get_right_neighbor(player: Player): Player
        +get_neighbors_in_range(player: Player, range: Integer): List<Player>
        +validate_position_selection(player: Player, position: Integer): Boolean
        +update_positions(): void
    }
}

package "💬 Système de Communication" {
    class ChatRoom {
        +id: UUID
        +game_id: UUID
        +name: String
        +chat_type: ChatType
        +participants: List<UUID>
        +is_private: Boolean
        +is_anonymous: Boolean
        +message_limit: Integer
        +character_limit: Integer
        --
        +add_participant(player: Player): void
        +remove_participant(player: Player): void
        +can_send_message(player: Player): Boolean
        +get_messages(): List<ChatMessage>
    }

    class CommunicationRule {
        +id: UUID
        +chat_room_id: UUID
        +rule_type: RuleType
        +condition: String
        +action: String
        +is_active: Boolean
        --
        +apply_rule(message: ChatMessage): Boolean
        +validate_message(message: ChatMessage): Boolean
    }
}

package "🔧 Services de Gestion" {
    class GameManager {
        +current_games: Map<UUID, Game>
        --
        +create_game(name: String, max_players: Integer): Game
        +start_game(game_id: UUID): void
        +end_game(game_id: UUID): void
        +add_player_to_game(game_id: UUID, player_id: UUID): void
        +remove_player_from_game(game_id: UUID, player_id: UUID): void
        +get_game_status(game_id: UUID): GameStatus
    }

    class RoleManager {
        +available_roles: List<Role>
        --
        +assign_roles_to_players(players: List<Player>): void
        +balance_teams(players: List<Player>): void
        +get_role_by_name(name: String): Role
        +validate_role_assignment(players: List<Player>): Boolean
    }

    class PhaseManager {
        +current_phase: Phase
        +phase_timer: Timer
        --
        +start_phase(phase: Phase): void
        +end_phase(): void
        +get_phase_remaining_time(): Integer
        +transition_to_next_phase(): void
    }

    class VoteManager {
        +active_votes: List<Vote>
        --
        +start_vote(vote_type: VoteType, targets: List<UUID>): void
        +cast_vote(voter_id: UUID, target_id: UUID): void
        +end_vote(): void
        +get_vote_results(): Map<UUID, Integer>
        +validate_vote(vote: Vote): Boolean
    }

    class WebSocketManager {
        +active_connections: Map<UUID, WebSocket>
        --
        +broadcast_message(message: String, recipients: List<UUID>): void
        +send_private_message(message: String, recipient: UUID): void
        +handle_connection(connection: WebSocket): void
        +handle_disconnection(connection: WebSocket): void
    }
}

package "🎭 Rôles Spéciaux" {
    abstract class SpecialRole {
        +special_power: Power
        +power_usage_count: Integer
        +max_power_usage: Integer
        --
        +can_use_special_power(): Boolean
        +use_special_power(target: UUID): void
    }

    class MarchandDeSable {
        +can_skip_accusation_phase: Boolean
        --
        +skip_accusation_phase(): void
    }

    class Epouvantail {
        --
        +protect_neighbors(): void
        +get_neighbor_positions(): List<Integer>
    }

    class Renard {
        --
        +flair_neighbors(): void
        +get_left_neighbors(): List<Player>
    }

    class Pestifere {
        +contamination_progress: Integer
        --
        +contaminate_target(target: Player): void
        +check_contamination_complete(): Boolean
    }

    class Jumeaux {
        +twin_id: UUID
        --
        +recognize_twin(): void
        +get_private_chat(): ChatRoom
    }
}

' ===== ÉNUMÉRATIONS =====
enum GameStatus {
    WAITING_FOR_PLAYERS
    LOBBY
    IN_PROGRESS
    PAUSED
    FINISHED
    CANCELLED
}

enum ActionType {
    KILL
    PROTECT
    INVESTIGATE
    TRANSFORM
    CONTROL
    SUPPORT
}

enum VoteType {
    ACCUSATION
    CONDEMNATION
    WOLF_TARGET
    ROLE_SPECIFIC
}

enum MessageType {
    PUBLIC
    PRIVATE
    TEAM
    ROLE
    SYSTEM
}

enum PowerType {
    ATTACK
    PROTECTION
    INFORMATION
    CONTROL
    SUPPORT
    TRANSFORMATION
}

enum TargetType {
    PLAYER
    POSITION
    TEAM
    SELF
    NONE
}

' ===== RELATIONS PRINCIPALES =====
' User et Player
User ||--o{ Player : "a des comptes"

' Game et ses composants
Game ||--o{ Player : "contient"
Game ||--o{ Phase : "a des phases"
Game ||--o{ Chair : "a des chaises"
Game ||--o{ GameAction : "génère"
Game ||--o{ Vote : "contient"
Game ||--o{ ChatRoom : "a des chats"

' Player et ses actions
Player ||--o{ GameAction : "effectue"
Player ||--o{ Vote : "vote"
Player ||--o{ ChatMessage : "envoie"
Player ||--o{ RoleTransformation : "subit"

' Role et ses pouvoirs
Role ||--o{ Power : "possède"
Role ||--o{ Player : "est assigné à"

' Power et ses effets
Power ||--o{ PowerEffect : "crée"
Power ||--o{ GameAction : "déclenche"

' Phase et ses permissions
Phase ||--o{ GameAction : "permet"
Phase ||--o{ Vote : "autorise"
Phase ||--o{ ChatMessage : "autorise"

' Chair et position
Chair ||--o{ Player : "est occupée par"
PositionManager ||--o{ Chair : "gère"

' Chat et communication
ChatRoom ||--o{ ChatMessage : "contient"
ChatRoom ||--o{ CommunicationRule : "applique"

' Services et leurs responsabilités
GameManager ||--o{ Game : "gère"
RoleManager ||--o{ Role : "gère"
PhaseManager ||--o{ Phase : "gère"
VoteManager ||--o{ Vote : "gère"
WebSocketManager ||--o{ Player : "connecte"

' Rôles spéciaux
SpecialRole <|-- MarchandDeSable
SpecialRole <|-- Epouvantail
SpecialRole <|-- Renard
SpecialRole <|-- Pestifere
SpecialRole <|-- Jumeaux

' ===== ACTIONS SPÉCIALISÉES =====
class KillAction {
    +target_id: UUID
    +kill_method: KillMethod
    +execute(): Boolean
}

class ProtectAction {
    +target_id: UUID
    +protection_type: ProtectionType
    +execute(): Boolean
}

class InvestigateAction {
    +target_id: UUID
    +investigation_type: InvestigationType
    +execute(): Boolean
}

class TransformAction {
    +target_id: UUID
    +transformation_type: TransformationType
    +execute(): Boolean
}

' Héritage des actions
GameAction <|-- KillAction
GameAction <|-- ProtectAction
GameAction <|-- InvestigateAction
GameAction <|-- TransformAction

' Relations d'équipe
Team ||--o{ Role : "contient des rôles"

@enduml
