@startuml WendigoGame_SOLID_Architecture
!theme plain
skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam classFontName Arial
skinparam packageStyle rectangle
skinparam linetype ortho

title 🏗️ Architecture SOLID - Wendigo Game (Refactorisée)

' ===== INTERFACES DE BASE (ABSTRActions) =====
package "🔌 Interfaces de Base" {
    interface IEntity {
        +id: UUID
        +created_at: DateTime
        +updated_at: DateTime
    }

    interface IIdentifiable {
        +id: UUID
    }

    interface ITimestamped {
        +created_at: DateTime
        +updated_at: DateTime
    }

    interface IValidatable {
        +validate(): Boolean
        +get_validation_errors(): List<String>
    }
}

package "🎮 Interfaces de Jeu" {
    interface IGame {
        +id: UUID
        +name: String
        +status: GameStatus
        +current_phase: IPhase
        +start_game(): void
        +end_game(): void
        +next_phase(): void
        +add_player(player: IPlayer): void
        +remove_player(player: IPlayer): void
    }

    interface IPlayer {
        +id: UUID
        +user_id: UUID
        +game_id: UUID
        +role_id: UUID
        +is_alive: Boolean
        +is_ready: Boolean
        +join_game(game: IGame): void
        +leave_game(): void
        +die(): void
        +revive(): void
    }

    interface IPhase {
        +id: UUID
        +name: String
        +duration: Integer
        +order: Integer
        +start_phase(): void
        +end_phase(): void
        +get_remaining_time(): Integer
        +can_execute_action(action: IGameAction): Boolean
    }
}

package "⚡ Interfaces de Rôles et Pouvoirs" {
    interface IRole {
        +id: UUID
        +name: String
        +description: String
        +team: ITeam
        +can_use_power(power: IPower, context: IGameContext): Boolean
        +execute_power(power: IPower, target: IPlayer, context: IGameContext): IPowerResult
    }

    interface IPower {
        +id: UUID
        +name: String
        +description: String
        +power_type: PowerType
        +target_type: TargetType
        +usage_limit: Integer
        +current_usage: Integer
        +can_use(context: IGameContext): Boolean
        +execute(target: IPlayer, context: IGameContext): IPowerResult
        +reset_usage(): void
    }

    interface IPowerResult {
        +success: Boolean
        +message: String
        +effects: List<IPowerEffect>
        +get_description(): String
    }

    interface IPowerEffect {
        +id: UUID
        +effect_type: EffectType
        +duration: Integer
        +strength: Integer
        +apply(target: IPlayer): void
        +remove(target: IPlayer): void
        +is_expired(): Boolean
    }
}

package "🪑 Interfaces de Position" {
    interface IPositionable {
        +get_position(): IPosition
        +set_position(position: IPosition): void
        +can_move_to(position: IPosition): Boolean
    }

    interface IPosition {
        +id: UUID
        +x: Integer
        +y: Integer
        +get_neighbors(): List<IPosition>
        +distance_to(other: IPosition): Integer
    }

    interface IChair extends IPosition {
        +is_occupied: Boolean
        +occupied_by: UUID
        +is_selectable: Boolean
        +occupy(player: IPlayer): void
        +vacate(): void
    }
}

package "💬 Interfaces de Communication" {
    interface IMessage {
        +id: UUID
        +content: String
        +sender_id: UUID
        +timestamp: DateTime
        +get_formatted_content(): String
    }

    interface IChatRoom {
        +id: UUID
        +name: String
        +participants: List<UUID>
        +add_participant(player: IPlayer): void
        +remove_participant(player: IPlayer): void
        +send_message(message: IMessage): void
        +get_messages(): List<IMessage>
    }
}

package "🔧 Interfaces de Services" {
    interface IGameManager {
        +create_game(name: String, max_players: Integer): IGame
        +start_game(game_id: UUID): void
        +end_game(game_id: UUID): void
        +get_game(game_id: UUID): IGame
        +get_all_games(): List<IGame>
    }

    interface IRoleManager {
        +assign_role_to_player(player: IPlayer, role: IRole): void
        +get_available_roles(): List<IRole>
        +create_custom_role(role_data: RoleData): IRole
        +validate_role_assignment(players: List<IPlayer]): Boolean
    }

    interface IPhaseManager {
        +start_phase(phase: IPhase): void
        +end_current_phase(): void
        +transition_to_next_phase(): void
        +get_current_phase(): IPhase
        +get_phase_remaining_time(): Integer
    }

    interface IVoteManager {
        +start_vote(vote_type: VoteType, targets: List<UUID]): void
        +cast_vote(voter_id: UUID, target_id: UUID): void
        +end_vote(): void
        +get_vote_results(): Map<UUID, Integer>
    }
}

' ===== IMPLÉMENTATIONS CONCRÈTES =====
package "🏠 Entités Concrètes" {
    class User implements IEntity, IIdentifiable, ITimestamped {
        +username: String
        +email: String
        +password_hash: String
        +is_active: Boolean
        +authenticate(password: String): Boolean
        +update_last_login(): void
    }

    class Player implements IPlayer, IEntity, IPositionable {
        +chair_position: IChair
        +has_selected_chair: Boolean
        +can_vote: Boolean
        +can_act: Boolean
        +select_chair(position: IChair): void
    }

    class Game implements IGame, IEntity {
        +phase_start_time: DateTime
        +phase_duration: Integer
        +min_players: Integer
        +max_players: Integer
        +current_player_count: Integer
        +winner_team: ITeam
    }
}

package "🎭 Rôles Concrètes" {
    abstract class BaseRole implements IRole, IEntity {
        +phase_action: IPhase
        +is_unique: Boolean
        +can_transform_team: Boolean
        +has_position_based_power: Boolean
        +has_communication_power: Boolean
        +get_power_description(): String
    }

    class Villager extends BaseRole {
        +team: VillagerTeam
    }

    class Wolf extends BaseRole {
        +team: WolfTeam
        +can_kill_target(target: IPlayer): Boolean
    }

    class SpecialRole extends BaseRole {
        +special_power: IPower
        +power_usage_count: Integer
        +max_power_usage: Integer
        +can_use_special_power(): Boolean
        +use_special_power(target: IPlayer): void
    }
}

package "⚡ Pouvoirs Concrètes" {
    abstract class BasePower implements IPower, IEntity {
        +phase_activation: IPhase
        +priority: Integer
        +validate_target(target: IPlayer): Boolean
        +check_usage_limit(): Boolean
    }

    class KillPower extends BasePower {
        +kill_method: KillMethod
        +execute(target: IPlayer, context: IGameContext): IPowerResult
    }

    class ProtectPower extends BasePower {
        +protection_type: ProtectionType
        +execute(target: IPlayer, context: IGameContext): IPowerResult
    }

    class InvestigatePower extends BasePower {
        +investigation_type: InvestigationType
        +execute(target: IPlayer, context: IGameContext): IPowerResult
    }
}

package "🔧 Services Concrètes" {
    class GameManager implements IGameManager {
        +current_games: Map[UUID, IGame]
        +game_repository: IGameRepository
        +create_game(name: String, max_players: Integer): IGame
    }

    class RoleManager implements IRoleManager {
        +available_roles: List[IRole]
        +role_factory: IRoleFactory
        +assign_role_to_player(player: IPlayer, role: IRole): void
    }

    class PhaseManager implements IPhaseManager {
        +current_phase: IPhase
        +phase_timer: ITimer
        +phase_repository: IPhaseRepository
        +start_phase(phase: IPhase): void
    }
}

' ===== FACTORIES ET REPOSITORIES =====
package "🏭 Factories et Repositories" {
    interface IRoleFactory {
        +create_role(role_type: RoleType, role_data: RoleData): IRole
        +create_custom_role(role_data: RoleData): IRole
        +get_role_template(role_type: RoleType): IRoleTemplate
    }

    interface IGameRepository {
        +save(game: IGame): void
        +find_by_id(game_id: UUID): IGame
        +find_all(): List[IGame]
        +delete(game_id: UUID): void
    }

    interface IRoleRepository {
        +save(role: IRole): void
        +find_by_id(role_id: UUID): IRole
        +find_by_type(role_type: RoleType): List[IRole]
        +find_available_roles(): List[IRole]
    }

    class RoleFactory implements IRoleFactory {
        +role_templates: Map[RoleType, IRoleTemplate]
        +create_role(role_type: RoleType, role_data: RoleData): IRole
    }

    class GameRepository implements IGameRepository {
        +database: IDatabase
        +save(game: IGame): void
    }
}

' ===== RELATIONS =====
' Implémentation des interfaces
IEntity <|.. User
IEntity <|.. Player
IEntity <|.. Game
IEntity <|.. BaseRole
IEntity <|.. BasePower

IPlayer <|.. Player
IGame <|.. Game
IRole <|.. BaseRole
IPower <|.. BasePower

' Héritage des rôles
BaseRole <|-- Villager
BaseRole <|-- Wolf
BaseRole <|-- SpecialRole

' Héritage des pouvoirs
BasePower <|-- KillPower
BasePower <|-- ProtectPower
BasePower <|-- InvestigatePower

' Services et leurs interfaces
IGameManager <|.. GameManager
IRoleManager <|.. RoleManager
IPhaseManager <|.. PhaseManager

' Factories et Repositories
IRoleFactory <|.. RoleFactory
IGameRepository <|.. GameRepository

' Relations de composition
GameManager --> IGameRepository
RoleManager --> IRoleFactory
PhaseManager --> IPhaseRepository

@enduml
