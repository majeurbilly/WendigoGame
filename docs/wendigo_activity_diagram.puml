@startuml Wendigo Game - Diagramme d'Activité Complet

!theme plain
skinparam backgroundColor #1a1a1a
skinparam activityBackgroundColor #2d2d2d
skinparam activityBorderColor #4a9eff
skinparam activityFontColor #ffffff
skinparam activityFontSize 12
skinparam activityDiamondBackgroundColor #2d2d2d
skinparam activityDiamondBorderColor #ff6b6b
skinparam activityDiamondFontColor #ffffff
skinparam activityStartColor #4caf50
skinparam activityEndColor #f44336
skinparam activityFontStyle bold

title 🐺 Wendigo Game - Diagramme d'Activité Complet

|#Système|
start
:Initialisation du serveur ASP.NET Core;
:Configuration de SignalR;
:Configuration de la base de données;
:Chargement des 29 rôles;

|#Joueur|
:Connexion au serveur;
:Authentification (login/création compte);

|#Système|
:Validation des identifiants;
:Création/chargement du profil joueur;

|#Joueur|
if (Avoir un lobby existant ?) then (oui)
  :Rejoindre un lobby existant;
else (non)
  :Créer un nouveau lobby;
  :Définir paramètres (min/max joueurs);
endif

|#Système|
:Ajouter le joueur au lobby;
:Broadcast mise à jour lobby via SignalR;

|#Joueur|
:Attendre d'autres joueurs;
:Confirmer "Prêt";

|#Système|
:Vérifier conditions de début;
if (Nombre de joueurs OK ?) then (oui)
  :Attribuer rôles aléatoirement;
  :Créer la partie;
  :Rediriger vers interface de jeu;
else (non)
  :Continuer l'attente;
  stop
endif

|#Joueur|
:Arriver physiquement dans la pièce;
:S'asseoir sur une chaise;

|#Système|
:Démarrer la partie;
:Phase JOUR (10 minutes);
:Broadcast début de phase;

|#Joueur|
:Discuter avec les autres joueurs;
:Préparer les accusations;

|#Système|
if (8 minutes écoulées ?) then (oui)
  :Activer sélection de chaises;
  :Broadcast ouverture sélection;
else (non)
  :Continuer phase Jour;
endif

|#Joueur|
if (Chaises sélectionnables ?) then (oui)
  :Sélectionner sa chaise physique;
  :Confirmer la sélection;
else (non)
  :Continuer à discuter;
endif

|#Système|
:Valider sélection de chaise;
:Rendre la chaise indisponible;
:Broadcast mise à jour chaises;

|#Joueur|
if (A sélectionné une chaise ?) then (oui)
  :Peut voter pour accuser;
else (non)
  :Ne peut pas voter (exclu);
endif

|#Système|
:Phase SOIR (Accusations dynamiques);
:Broadcast début phase Soir;

|#Joueur|
if (Peut voter ?) then (oui)
  :Voter pour accuser un joueur;
else (non)
  :Observer les votes;
endif

|#Système|
:Compter les votes en temps réel;
:Broadcast résultats votes;
if (Joueur le plus voté ?) then (oui)
  :Mettre sur le bûcher;
  :Démarrer défense (1 minute);
else (non)
  :Continuer les accusations;
endif

|#Joueur|
if (Sur le bûcher ?) then (oui)
  :Se défendre (1 minute);
else (non)
  :Voter pour tuer/épargner;
endif

|#Système|
:Compter votes de condamnation;
if (Majorité pour tuer ?) then (oui)
  :Tuer le joueur;
  :Transformer en Fantôme;
else (non)
  :Épargner le joueur;
endif

|#Joueur|
if (Mort ?) then (oui)
  :Devenir Fantôme;
  :Accéder au chat des fantômes;
else (non)
  :Continuer à jouer;
endif

|#Système|
:Phase NUIT;
:Broadcast début de nuit;
:Activer système de vibration séquentielle;

|#Joueur|
:Fermer les yeux;
:Attendre sa vibration;

|#Système|
:Choisir ordre aléatoire des joueurs;
:Vibrer le premier joueur;

|#Joueur|
if (Vibration reçue ?) then (oui)
  :Écran s'illumine;
  :15 secondes pour agir;
  if (A un pouvoir à utiliser ?) then (oui)
    :Utiliser son pouvoir;
    :Sélectionner une cible;
  else (non)
    :Cliquer "Continuer";
  endif
else (non)
  :Attendre;
endif

|#Système|
:Enregistrer l'action;
:Attendre 5 secondes;
if (Tous les joueurs ont joué ?) then (non)
  :Vibrer le joueur suivant;
else (oui)
  :Résoudre les actions par priorité;
endif

|#Système|
:Appliquer ordre de priorité des actions;
:Phase RÉVEIL;
:Annoncer les morts de la nuit;

|#Joueur|
if (Mort cette nuit ?) then (oui)
  :Devenir Fantôme;
  :Accéder au chat des fantômes;
else (non)
  :Se réveiller;
endif

|#Système|
:Vérifier conditions de victoire;
if (Il reste des Loups ET des Villageois ?) then (oui)
  :Retourner à Phase JOUR;
else (non)
  :Déclarer le vainqueur;
  :Fin de partie;
endif

|#Joueur|
if (Partie terminée ?) then (oui)
  :Voir les résultats;
  :Retourner au lobby;
else (non)
  :Continuer la partie;
endif

|#Système|
:Sauvegarder l'historique complet;
:Calculer les statistiques;
:Broadcast fin de partie;

stop

note right of |#Système|
  **Systèmes Spéciaux :**
  
  **🎭 Chat des Loups :**
  - 1 message/jour, max 15 caractères
  - Vote unanime requis pour tuer
  
  **👻 Système de Fantômes :**
  - Transformation automatique à la mort
  - Chat exclusif avec le Médium
  
  **🪑 Sélection de Chaises :**
  - Lien physique-numérique
  - Chaises exclusives
  
  **📱 Vibration Séquentielle :**
  - Ordre aléatoire
  - 15s d'action + 5s d'attente
end note

note left of |#Joueur|
  **29 Rôles Uniques :**
  
  **🐺 6 Loups :**
  - Skinwalker, Bouc Émissaire
  - Warlord, Sbire, Marchand de Sable
  - Pestiféré
  
  **🛡️ 23 Villageois :**
  - Voyante, Épouvantail, Corbeau
  - Renard, Rêveur, Poltergeist
  - Coroner, Psychopompe, etc.
  
  **👻 1 Rôle Post-Mortem :**
  - Fantôme (transformation automatique)
end note

@enduml

