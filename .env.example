# Copier vers .env et ajuster (le fichier .env est ignoré par git).

# --- Docker Compose : profils ---
# Par défaut, Prometheus / Loki / Grafana ne partent pas (évite Docker Hub en dev).
# Pour les activer : décommenter la ligne suivante, ou lancer :
#   docker compose --profile observability up -d
# COMPOSE_PROFILES=observability

# Si Docker Hub renvoie « toomanyrequests » ou « too many failed login attempts » :
#   docker logout
#   docker login   # compte hub.docker.com (gratuit) — augmente les quotas de pull

# --- Authentik (obligatoire pour démarrer les services Authentik) ---
# Clé secrète Django / Authentik : minimum ~50 caractères en production.
AUTHENTIK_SECRET_KEY=change-me-to-a-long-random-string-at-least-fifty-characters-long
AUTHENTIK_PG_PASS=authentik-postgres-dev-password
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_DB=authentik

# Compte bootstrap initial (recommandé au premier lancement).
# AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
# AUTHENTIK_BOOTSTRAP_PASSWORD=ChangeMeNow123

# Ports exposés sur l’hôte (optionnel).
# AUTHENTIK_HTTP_PORT=9000
# AUTHENTIK_HTTPS_PORT=9443

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# GRAFANA_HTTP_PORT=3000

# --- Backend (OIDC JWKS + LiveKit) ---
# Issuer attendu dans le JWT (souvent localhost côté navigateur).
# OIDC_EXPECTED_ISSUER=http://localhost:9000/application/o/wendigo/
# Base pour télécharger le JWKS depuis le conteneur (souvent authentik-server en Docker).
# OIDC_ISSUER_URL=http://authentik-server:9000/application/o/wendigo/
# AUTHENTIK_JWKS_URL=http://authentik-server:9000/application/o/wendigo/jwks/
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- Build frontend (arguments Docker build) ---
# VITE_API_URL=http://localhost:8080
# VITE_LIVEKIT_URL=ws://localhost:7880
# Issuer OIDC (cuits dans le bundle au docker build — obligatoire pour le bouton de connexion).
# VITE_AUTHENTIK_URL=http://localhost:9000/application/o/wendigo
# VITE_AUTHENTIK_CLIENT_ID=wendigo-dev
# Ne pas mettre GOOGLE_CLIENT_ID ici : c’est la source OAuth Google dans Authentik, pas le client OIDC SPA.

# --- Jeu (PostgreSQL applicatif) ---
WENDIGO_PG_PASSWORD=wendigo

# --- Image Authentik (optionnel) ---
# AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
# AUTHENTIK_TAG=2024.12.5
