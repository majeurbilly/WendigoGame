VITE_API_URL=http://localhost:8081
VITE_LIVEKIT_URL=ws://localhost:7880
# Issuer OIDC Authentik pour l’application « wendigo » (sans slash final). Ex. docker : http://localhost:9002/application/o/wendigo
VITE_AUTHENTIK_URL=http://localhost:9002/application/o/wendigo
# Provider OIDC Wendigo (PAS la clé Google — voir GOOGLE_CLIENT_ID dans infrastructure/authentik)
VITE_AUTHENTIK_CLIENT_ID=wendigo-dev
# Redirect URI à déclarer dans Authentik : doit correspondre à l’URL du frontend (ex. http://localhost:5173/ si BASE_URL=/)
