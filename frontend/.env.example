VITE_API_URL=http://localhost:8080
VITE_LIVEKIT_URL=ws://localhost:7880
# Issuer OIDC Authentik pour l’application « wendigo » (sans slash final). Ex. docker : http://localhost:9000/application/o/wendigo
VITE_AUTHENTIK_URL=http://localhost:9000/application/o/wendigo
# Identifiant client OAuth2 « public » (SPA) défini dans Authentik
VITE_AUTHENTIK_CLIENT_ID=
# Redirect URI à déclarer dans Authentik : doit correspondre à l’URL du frontend (ex. http://localhost:5173/ si BASE_URL=/)
