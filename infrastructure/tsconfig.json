{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "bin",
    "rootDir": "."
  },
  "include": [
    "index.ts",
    "src/k8s/**/*.ts",
    "src/authentik/oidc-app.ts",
    "src/authentik/applications/providers/oidc-provider-resource.ts",
    "src/utils.ts"
  ],
  "exclude": ["node_modules", "bin", "sdks", "scripts"]
}
