# Authentik API — utiliser Pulumi config (recommandé), PAS ce fichier pour le token :
#   pulumi config set authentik:url http://localhost:9000
#   pulumi config set --secret authentik:token "ak-..."
# Créer le token : Admin → Directory → Tokens → Create (intention API)
# AUTHENTIK_TOKEN dans .env est ignoré volontairement (évite d'écraser la config Pulumi).

# Identifiants OIDC du provider Wendigo (dev) — prioritaires sur pulumi config wendigo:clientId
WENDIGO_OIDC_CLIENT_ID=wendigo-dev
# Optionnel pour client confidential ; laisser vide pour client public (SPA + PKCE)
WENDIGO_OIDC_CLIENT_SECRET=

# Google OAuth (Console Cloud → Identifiants → URI de redirection = callback Authentik)
# Après `pulumi up`, récupérer googleCallbackUri dans les outputs stack.
# Console Google Cloud → OAuth 2.0 (type « application Web »), pas le client OIDC wendigo-dev
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# TLS dev (certificat auto-signé)
# AUTHENTIK_INSECURE=true
